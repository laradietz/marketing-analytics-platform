# Copy to .env (or export as real environment variables) for a local run
# without Docker: `mvnw spring-boot:run` reads these via Spring's
# environment-variable placeholders in application.yml.

DB_URL=jdbc:postgresql://localhost:5432/marketing_analytics
DB_USERNAME=marketing_user
DB_PASSWORD=marketing_pass

SERVER_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_SECRET=change-this-development-only-secret-key-please-32chars-min
JWT_EXPIRATION_MINUTES=1440

SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@marketinganalytics.com
DEMO_USER_PASSWORD=Demo1234!

LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
