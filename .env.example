# Copy this file to .env and adjust as needed before running `docker compose up`.

DB_NAME=marketing_analytics
DB_USERNAME=marketing_user
DB_PASSWORD=marketing_pass

JWT_SECRET=change-this-development-only-secret-key-please-32chars-min
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@marketinganalytics.com
DEMO_USER_PASSWORD=Demo1234!

VITE_API_URL=http://localhost:8080/api
